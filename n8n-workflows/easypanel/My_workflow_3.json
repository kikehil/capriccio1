      "position": [
        -224,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst telefono = body.telefono?.toString().replace(/[^0-9]/g, '') || '';\nconst nombre = body.nombre || 'Cliente';\nconst codigo = body.codigo || '';\n\n// Formatear número para WhatsApp (México: agregar 521 si no lo tiene)\nlet waNumber = telefono;\nif (waNumber.startsWith('52') && waNumber.length === 12) {\n  waNumber = '521' + waNumber.slice(2);\n} else if (waNumber.length === 10) {\n  waNumber = '521' + waNumber;\n}\n\nconst mensaje = `🍕 *Capriccio Pizza*\\n\\n¡Hola ${nombre}! 👋\\n\\nTu código de verificación es:\\n\\n*${codigo}*\\n\\n⏰ Válido por 15 minutos.\\nIngresa este código en la pantalla de verificación para activar tu cuenta.\\n\\n¡Gracias por registrarte! 🎉`;\n\nreturn [{\n  json: {\n    waNumber,\n    telefono,\n    nombre,\n    codigo,\n    mensaje\n  }\n}];"
      },
      "id": "9352134d-06ed-4ec3-9734-79a9e0b8d8cf",
      "name": "Formatear número y mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, enviado: true, numero: $('Formatear número y mensaje').item.json.waNumber }) }}",
        "options": {}
      },
      "id": "0c244a8f-9813-4276-98b2-03f307e58f45",
      "name": "Responder OK",
